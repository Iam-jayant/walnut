{
  "name": "walnut",
  "description": "Confidential lending protocol on Fhenix — encrypted positions, private settlement",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev --webpack",
    "build": "npx hardhat compile && next build --webpack",
    "start": "next start",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "deploy:arbitrum-sepolia": "hardhat run scripts/deploy-sepolia.js --network arbitrumSepolia",
    "deploy:wave2:arbitrum-sepolia": "hardhat run scripts/deploy-wave2-sepolia.js --network arbitrumSepolia"
  },
  "dependencies": {
    "@cofhe/abi": "^0.5.0",
    "@cofhe/react": "^0.5.0",
    "@cofhe/sdk": "^0.5.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-slot": "1.1.1",
    "@rainbow-me/rainbowkit": "^2.2.10",
    "@reineira-os/sdk": "^0.3.1",
    "@tanstack/react-query": "^5.95.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vercel/analytics": "1.3.1",
    "bs58": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "gsap": "^3.14.2",
    "lucide-react": "^0.454.0",
    "mermaid": "^11.15.0",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "viem": "^2.47.6",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@chainlink/contracts": "^1.5.0",
    "@cofhe/hardhat-plugin": "^0.5.2",
    "@fhenixprotocol/cofhe-contracts": "^0.1.3",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@tailwindcss/postcss": "^4.1.9",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chai": "^5.2.3",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.0.2",
    "chai": "^6.2.2",
    "dotenv": "^16.4.7",
    "fast-check": "^4.8.0",
    "hardhat": "^2.24.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5",
    "tailwindcss": "^4.1.9",
    "ts-node": "^10.9.2",
    "tw-animate-css": "1.3.3",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
