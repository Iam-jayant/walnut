# ============================================
# REQUIRED: DEPLOYMENT & BACKEND
# ============================================

# Private key for contract deployment (without 0x prefix)
# Get from MetaMask: Account Details > Export Private Key
PRIVATE_KEY=your_private_key_here

# Arbitrum Sepolia RPC URL (used by Hardhat)
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Arbiscan API key for contract verification
# Get from: https://arbiscan.io/myapikey
ARBISCAN_API_KEY=your_arbiscan_api_key_here

# ============================================
# REQUIRED: FRONTEND (NEXT_PUBLIC_*)
# ============================================

# Network Configuration
NEXT_PUBLIC_CHAIN_ID=421614

# RPC Endpoints (Primary + Fallbacks)
NEXT_PUBLIC_RPC_URL_PRIMARY=https://sepolia-rollup.arbitrum.io/rpc
NEXT_PUBLIC_RPC_URL_FALLBACK_1=https://arbitrum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_RPC_URL_FALLBACK_2=https://endpoints.omniatech.io/v1/arbitrum/sepolia/public

# WalletConnect Project ID
# Get from: https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# ============================================
# REQUIRED: CONTRACT ADDRESSES
# ============================================

# WalnutV1 (Wave 1-3: Core FHE Lending)
NEXT_PUBLIC_CONTRACT_ADDRESS=0x04c998DD105E444570ba1eCACB3F5524D5695aA0

# WalnutV2 (Wave 4: Token Economics)
NEXT_PUBLIC_V2_CONTRACT_ADDRESS=0xaEBF0CD234779DA76cD2F938Fdd029F80b6F98da
NEXT_PUBLIC_FHERC20_ADDRESS=0xC5C8188ECb061dFAaA0bab0865dBd5dDA0218740
NEXT_PUBLIC_ORACLE_ADDRESS=0xA8621c45bfe3A4f163b17Ba509735118fbC7610e
NEXT_PUBLIC_MOCK_USDC_ADDRESS=0x8B7Af5BB6afc6A087fd94A97f53Bf13dFD63E1E2

# ============================================
# REQUIRED: PRIVARA SETTLEMENT
# ============================================

# Private key for Privara settlement transactions (without 0x prefix)
# Can be same as PRIVATE_KEY or a separate key for settlement
PRIVARA_SETTLEMENT_PRIVATE_KEY=your_settlement_private_key_here

# Lender pool address for Privara escrow
LENDER_POOL_ADDRESS=0x65c3768E98eE211a7589fe94c753e11cB8895069

# Privara coordinator URL (optional, has default)
PRIVARA_COORDINATOR_URL=https://dswtxw6k9mker.cloudfront.net

# ============================================
# OPTIONAL: ADDITIONAL TOKENS
# ============================================

# WETH address
# NEXT_PUBLIC_WETH_ADDRESS=